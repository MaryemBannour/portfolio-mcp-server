{
  "manifest_version": "0.2",
  "name": "portfolio-mcp-server",
  "version": "1.0.0",
  "description": "Serveur MCP exposant le profil professionnel de Maryem Bannour (expériences, projets, compétences) comme outils interrogeables par un client MCP (Claude Desktop, Claude Code...).",
  "author": {
    "name": "Maryem Bannour",
    "email": "meryembannour3@gmail.com"
  },
  "server": {
    "type": "node",
    "entry_point": "src/server.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/src/server.js"
      ],
      "env": {}
    }
  },
  "tools": [
    {
      "name": "get_experiences"
    },
    {
      "name": "list_projects"
    },
    {
      "name": "get_skills"
    },
    {
      "name": "add_project"
    }
  ],
  "keywords": [
    "portfolio",
    "cv",
    "career",
    "ai",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaryemBannour/portfolio-mcp-server"
  }
}
